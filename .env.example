# Переменные окружения (скопируйте в .env.local)

# === Админ-панель (обязательно) ===
ADMIN_PASSWORD=your-secure-password
ADMIN_SECRET=random-secret-string-for-jwt

# === База данных PostgreSQL (бесплатно: Neon.tech или Supabase) ===
# Локально: docker compose up -d && DATABASE_URL ниже
DATABASE_URL=postgresql://izhsiz:izhsiz@localhost:5432/izhsiz

# Telegram — уведомления о заявках (п.15 ТЗ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI — напрямую (альтернатива OpenRouter)
OPENAI_API_KEY=

# OpenRouter — рекомендуется: один ключ, много моделей (https://openrouter.ai)
OPENROUTER_API_KEY=
# Бесплатно на OpenRouter (если одна модель падает — код пробует другие):
# qwen/qwen3-next-80b-a3b-instruct:free
# meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Публичный URL сайта (для OpenRouter HTTP-Referer)
NEXT_PUBLIC_SITE_URL=https://psychologydemo-ten.vercel.app

# === Вход пользователей в ИИ-инструменты + отправка разбора на email ===
# Рекомендуется: SMTP Yandex (письма на любую почту без своего домена)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=ваш-ящик@yandex.ru
SMTP_PASS=пароль_приложения_из_яндекса
SMTP_FROM=ИЖСИЗ <ваш-ящик@yandex.ru>

# Запасной вариант: Resend (нужен свой домен для любых получателей)
RESEND_API_KEY=
EMAIL_FROM=ИЖСИЗ <onboarding@resend.dev>

USER_SESSION_SECRET=random-secret-for-user-jwt

# Email админов через аккаунт (через запятую). Получают role=admin при входе.
ADMIN_EMAILS=medvedev_ea67@mail.ru

# Онлайн-касса (п.16 ТЗ) — провайдер по выбору заказчика
# PAYMENT_SHOP_ID=
# PAYMENT_SECRET_KEY=
