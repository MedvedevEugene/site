# Переменные окружения (скопируйте в .env.local)

# === Админ-панель (обязательно) ===
ADMIN_PASSWORD=your-secure-password
ADMIN_SECRET=random-secret-string-for-jwt

# === База данных PostgreSQL (бесплатно: Neon.tech или Supabase) ===
# Локально: docker compose up -d && DATABASE_URL ниже
DATABASE_URL=postgresql://izhsiz:izhsiz@localhost:5432/izhsiz

# Telegram — уведомления о заявках (п.15 ТЗ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI — ИИ-разбор NLP-инструментов
OPENAI_API_KEY=

# Онлайн-касса (п.16 ТЗ) — провайдер по выбору заказчика
# PAYMENT_SHOP_ID=
# PAYMENT_SECRET_KEY=
