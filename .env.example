# Переменные окружения (скопируйте в .env.local)

# === Админ-панель (обязательно) ===
ADMIN_PASSWORD=your-secure-password
ADMIN_SECRET=random-secret-string-for-jwt

# === База данных PostgreSQL (бесплатно: Neon.tech или Supabase) ===
# Локально: docker compose up -d && DATABASE_URL ниже
DATABASE_URL=postgresql://izhsiz:izhsiz@localhost:5432/izhsiz

# Telegram — уведомления о заявках (п.15 ТЗ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI — напрямую (альтернатива OpenRouter)
OPENAI_API_KEY=

# OpenRouter — рекомендуется: один ключ, много моделей (https://openrouter.ai)
OPENROUTER_API_KEY=
# Примеры: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-flash-1.5
AI_MODEL=openai/gpt-4o-mini

# Публичный URL сайта (для OpenRouter HTTP-Referer)
NEXT_PUBLIC_SITE_URL=https://psychologydemo-ten.vercel.app

# Онлайн-касса (п.16 ТЗ) — провайдер по выбору заказчика
# PAYMENT_SHOP_ID=
# PAYMENT_SECRET_KEY=
